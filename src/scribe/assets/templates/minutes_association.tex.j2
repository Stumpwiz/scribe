% Report appendices use \reportbegin, repeated \reportpage calls, and \reportend.
% Page names are generated from the formatter manifest when available.

\newcommand{\ReportPath}[1]{\reportsDir/\detokenize{#1}}
\newcommand{\SafeIncludeReport}[1]{
    \IfFileExists{\ReportPath{#1}}{
        \includegraphics[
            max width=\textwidth,
            max height=\adjustedtextheight,
            keepaspectratio
        ]{\ReportPath{#1}}
    }{
        \IfFileExists{\ReportPath{#1}.pdf}{
            \includegraphics[
                max width=\textwidth,
                max height=\adjustedtextheight,
                keepaspectratio
            ]{\ReportPath{#1}.pdf}
        }{
            \IfFileExists{\ReportPath{#1}.png}{
                \includegraphics[
                    max width=\textwidth,
                    max height=\adjustedtextheight,
                    keepaspectratio
                ]{\ReportPath{#1}.png}
            }{
                \IfFileExists{\ReportPath{#1}.jpg}{
                    \includegraphics[
                        max width=\textwidth,
                        max height=\adjustedtextheight,
                        keepaspectratio
                    ]{\ReportPath{#1}.jpg}
                }{
                    \IfFileExists{\ReportPath{#1}.jpeg}{
                        \includegraphics[
                            max width=\textwidth,
                            max height=\adjustedtextheight,
                            keepaspectratio
                        ]{\ReportPath{#1}.jpeg}
                    }{
                        \null
                    }
                }
            }
        }
    }
}

\newif\ifreportfirstpage
\newcommand{\reportbegin}[2]{
    \clearpage
    \section{#1}
    \label{app:#2}
    \reportfirstpagetrue
}

\newcommand{\reportpage}[1]{
    \ifreportfirstpage
        \reportfirstpagefalse
    \else
        \clearpage
    \fi
    {
        \centering
        \SafeIncludeReport{#1}
    }
    \raggedright
}

\newcommand{\reportend}{}

\NewDocumentCommand{\report}{m m m o o o o o o}{
    \reportbegin{#1}{#2}
    \reportpage{#3}
    \IfValueT{#4}{\reportpage{#4}}
    \IfValueT{#5}{\reportpage{#5}}
    \IfValueT{#6}{\reportpage{#6}}
    \IfValueT{#7}{\reportpage{#7}}
    \IfValueT{#8}{\reportpage{#8}}
    \IfValueT{#9}{\reportpage{#9}}
    \reportend
}
