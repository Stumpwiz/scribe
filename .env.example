# Database Configuration
# Shared PostgreSQL database with clerk project (AWS RDS for production, or local for development)
DATABASE_URL=postgresql+psycopg2://clerk_user:password@localhost:5432/clerk_community_admin?sslmode=require

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here
MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1024
OPENAI_RETRIES=1

# Email Configuration
# Sender identity and reminder-sender recognition; OAuth token selects the account.
EMAIL_FROM=reminders@example.com
EMAIL_SENDER_NAME="Scribe Council Secretary"

# Default fallback email for testing or when recipients are not specified
DEFAULT_FALLBACK_EMAIL=secretary@example.com

# Legacy Recipients Directory (not needed by normal Clerk-based reminders or ingestion)
# Older JSON interfaces only: council_members.json and committee_chairs.json.
# Normal reminders query Clerk: Regular officers; Open/Association officers + chairs.
# Note: This directory should NOT be committed to git (see .gitignore)
RECIPIENTS_DIR=/path/to/instance/recipients

# Dry Run Mode
# Set to "true" to prevent actual email sending (emails are logged but not sent)
# Set to "false" for production use
DRY_RUN=true

# Development Email Override (Optional)
# Redirects non-dry-run EmailService sends to this address instead of real recipients.
# Use this for testing email sending without bothering real users.
# Example: DEV_OVERRIDE_EMAIL=test-user@example.com
# DEV_OVERRIDE_EMAIL=

# Run ID (Optional)
# Unique identifier for tracking a specific run of the application
# Auto-generated if not provided
# RUN_ID=abc123

# AssemblyAI Configuration (Optional)
# Only needed if using audio transcription features
# Get your API key from https://www.assemblyai.com/
# ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# Report submissions and agenda corrections; defaults to EMAIL_FROM when unset.
REPORT_SUBMISSION_EMAIL=reports@example.com
